#!/bin/sh
# Stub srt (ADR-0020): checks the settings file exists, then runs the command as given.
# It sandboxes nothing; only tests/security/test_gate_sandbox.py runs under the real one.
# When $HOME/.stub-srt is a directory, every settings file is copied there first, so a test can
# read the profile each process got (red-team v0.3).
if [ "$1" = "--version" ]; then
  echo "0.0.81"
  exit 0
fi
if [ "$1" != "--settings" ] || [ ! -f "$2" ] || [ "$3" != "--" ]; then
  echo "stub srt: unsupported arguments: $*" >&2
  exit 1
fi
if [ -d "$HOME/.stub-srt" ]; then
  cp "$2" "$(mktemp "$HOME/.stub-srt/settings.XXXXXX")" || exit 1
fi
shift 3
exec "$@"
