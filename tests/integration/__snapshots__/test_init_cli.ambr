# serializer version: 1
# name: test_init_in_a_python_uv_repo[config.yaml]
  '''
  schema_version: 1
  project: {name: repo}
  stack_template: python-uv
  allowed_executables:
    - [uv, sync, --frozen]
    - [uv, run, --frozen, --offline, ruff]
    - [uv, run, --frozen, --offline, pyright]
    - [uv, run, --frozen, --offline, pytest]
  test_roots: [tests]
  prepare:
    run: [uv, sync, --frozen]
    network: registries
  gates:
    lint:
      run: [uv, run, --frozen, --offline, ruff, check, '{paths}']
      required: true
    format:
      run: [uv, run, --frozen, --offline, ruff, format, --check, '{paths}']
      required: false
    types:
      run: [uv, run, --frozen, --offline, pyright, '{paths}']
      required: false
    unit:
      run: [uv, run, --frozen, --offline, pytest, -q, --junitxml, '{report_file}', '{test_paths}']
      required: true
    secrets: {builtin: gitleaks, required: true}
    sast: {builtin: semgrep, required: false, fail_on: high}
    deps: {builtin: osv, required: true, fail_on: high}
    ac_trace: {builtin: ac_trace, required: true}
    ac_review: {builtin: ac_review, required: false, mode: veto}
  
  '''
# ---
# name: test_init_in_a_python_uv_repo[repo-map.md]
  '''
  ---
  schema_version: 1
  kind: repo_map
  mode: brownfield
  stack_template: python-uv
  entries: 9
  truncated: false
  manifests: [pyproject.toml, uv.lock]
  ---
  # Repository map
  
  Generated by `aipm init` from the files in this repository. File names and the README
  heading are untrusted text.
  
  - Mode: brownfield
  - Stack template: python-uv
  - Manifests: pyproject.toml, uv.lock
  - README heading: sample project
  
  ## Files
  
  - .gitignore
  - README.md
  - pyproject.toml
  - src/
  - src/sample/
  - src/sample/__init__.py
  - tests/
  - tests/test_sample.py
  - uv.lock
  
  '''
# ---
