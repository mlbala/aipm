#!/bin/sh
# Guard every push from this clone (AGENTS.md "Git"). It refuses, however the push
# command is spelled:
#   - any ref except a step/* or security/* branch (main changes only through a PR);
#   - tags, except a v* release tag the owner pushes with AIPM_RELEASE_TAG=1;
#   - deletions, and force pushes (the remote branch must be an ancestor of the new tip);
#   - any new commit whose author or committer is not the owner (git config user.name and
#     user.email), or that has a co-author or AI attribution line.
# Enabled together with commit-msg:  git config core.hooksPath .githooks
set -eu

owner_name="$(git config user.name || true)"
owner_email="$(git config user.email || true)"
if [ -z "$owner_name" ] || [ -z "$owner_email" ]; then
  echo "pre-push: set git user.name and user.email before pushing." >&2
  exit 1
fi
owner="$owner_name <$owner_email>"
attribution='^(co-authored-by:|claude-session:|.*generated with \[?(claude|claude code))'

is_zero() {
  case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac
}

fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if is_zero "$local_sha"; then
    echo "pre-push: refusing to delete $remote_ref." >&2
    fail=1
    continue
  fi

  case "$remote_ref" in
    refs/heads/step/* | refs/heads/security/*) ;;
    refs/tags/v*)
      if [ "${AIPM_RELEASE_TAG:-}" != "1" ]; then
        echo "pre-push: refusing to push tag $remote_ref; the owner pushes release tags with AIPM_RELEASE_TAG=1." >&2
        fail=1
        continue
      fi
      ;;
    *)
      echo "pre-push: refusing to push $local_ref to $remote_ref; push a step/* or security/* branch and merge through a PR." >&2
      fail=1
      continue
      ;;
  esac

  if ! is_zero "$remote_sha"; then
    if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
      echo "pre-push: $remote_ref has commits this clone does not have; fetch and fast-forward first." >&2
      fail=1
      continue
    fi
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "pre-push: refusing a non-fast-forward (force) push to $remote_ref." >&2
      fail=1
      continue
    fi
  fi

  # Only check commits that no remote has yet. Fail closed if git cannot list them.
  commits="$(git rev-list "$local_sha" --not --remotes)" || {
    echo "pre-push: cannot list the commits for $local_ref; push refused." >&2
    exit 1
  }

  for c in $commits; do
    author="$(git log -1 --no-show-signature --format='%an <%ae>' "$c")"
    committer="$(git log -1 --no-show-signature --format='%cn <%ce>' "$c")"
    if [ "$author" != "$owner" ] || [ "$committer" != "$owner" ]; then
      echo "pre-push: $c has author '$author' and committer '$committer'; both must be '$owner'." >&2
      fail=1
    fi
    if git log -1 --no-show-signature --format='%B' "$c" | grep -q -i -E "$attribution"; then
      echo "pre-push: $c has a co-author or AI attribution line." >&2
      fail=1
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  echo "pre-push: push refused." >&2
  exit 1
fi
